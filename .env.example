# Server
SERVER_PORT=4310
DATABASE_PATH=./data/vinny-editor.sqlite
WORKSPACE_ROOT=./workspace

# Auth (required once the server is reachable through the Cloudflare tunnel)
AUTH_PASSPHRASE=change-me
SESSION_SECRET=change-me-too
# Set to true to skip the login screen entirely - only do this if you
# understand that your tunnel URL is public: anyone who ever gets that link
# can then open this app and run commands on this PC, no login required.
AUTH_DISABLED=false

# Ollama (never exposed publicly — the server talks to it over localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# Web dev server
WEB_PORT=4173
